# Copy this file to `.env` and fill in your real values.
# NEVER commit the real .env file — it is gitignored.

# Todoist API token — get it from https://todoist.com/app/settings/integrations/developer
TODOIST_API_TOKEN=your_todoist_token_here

# Notion integration token — create one at https://www.notion.so/profile/integrations
NOTION_API_TOKEN=your_notion_token_here

# Notion data source ID for your Tasks database
# (open the database in Notion → Share → Copy link → the ID is the long string after notion.so/)
NOTION_DATA_SOURCE_ID=your_notion_database_id_here

# Notion user ID of the person whose tasks should be synced
NOTION_USER_ID=your_notion_user_id_here

# Todoist project ID where tasks will be created (e.g. your Inbox)
TODOIST_INBOX_ID=your_todoist_project_id_here

# Comma-separated labels to attach to created Todoist tasks
TODOIST_LABELS=notion_task
